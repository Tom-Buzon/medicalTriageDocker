# Full merged model stored on Hugging Face.
MODEL_ID=qneaup/qwen3-1.7b-medical-triage-sft-dpo

# Recommended for AWS deployments: use an immutable Hugging Face commit SHA.
# Leave empty during early local development to use the repository default branch.
MODEL_REVISION=

SERVED_MODEL_NAME=triage-model
MODEL_DTYPE=bfloat16
MAX_MODEL_LEN=1024
MAX_NUM_SEQS=1
VLLM_CPU_KVCACHE_SPACE=2

# Random URL path used only to make opportunistic discovery less likely.
# Generate with: openssl rand -hex 32
# Open Streamlit with: http://HOST:8501/THE_GENERATED_VALUE
APP_URL_PATH=

# Only needed for a private/gated repository or higher Hub rate limits.
# Never commit a real token.
# HF_TOKEN=hf_example
